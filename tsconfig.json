{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@route": ["src/route/index"],
      "@screen/*": ["src/screen/*"],
      "@theme": ["src/theme/index"],
      "@utils/*": ["src/utils/*"],
      "@validation/*": ["src/validation/*"]
    }
  }
}
