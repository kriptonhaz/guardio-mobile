{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@assets/*": ["assets/*"],
      "@components/*": ["components/*"],
      "@interfaces/*": ["interfaces/*"],
      "@route": ["route/index"],
      "@screen/*": ["screen/*"],
      "@theme": ["theme/index"],
      "@utils/*": ["utils/*"],
      "@validation/*": ["validation/*"]
    }
  }
}
